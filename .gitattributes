* text=auto eol=lf

# Windows batch files need CRLF line endings to run reliably. `-text` turns
# off line-ending conversion, so the blob holds the committed CRLF bytes, and
# a checkout and `git archive` write those bytes unchanged. To show it, run
# these two commands in a clone. No output from `cmp` means that the bytes
# match the blob:
#   cmp start_windows.bat <(git cat-file -p HEAD:start_windows.bat)
#   git archive HEAD start_windows.bat | tar -xO | cmp - <(git cat-file -p HEAD:start_windows.bat)
# scripts/tests/test_launcher_line_endings.sh checks that each blob is CRLF.
*.bat -text
*.cmd -text

# Shell/command launchers must stay LF
*.sh text eol=lf
*.command text eol=lf
